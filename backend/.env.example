# Copy to .env and fill in. Never commit .env.   Easier: run  python setup_local.py  (it writes this file for you).
# A NEW database is used so the old "workcode" database is left untouched.
# Create it once:  createdb -p 5433 -U postgres workcode_v2
DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_ME@127.0.0.1:5433/workcode_v2
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
ACCESS_TOKEN_MINUTES=720
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
MAX_ADMINS=3
INTERN_TARGET_HEADCOUNT=10
OFFROLL_TRAINING_MONTHS=6
TIMEZONE=Asia/Kolkata

# Only read for files uploaded before build 20. New uploads and recordings are stored in the database.
STORAGE_DIR=./storage

# Code runner (needs Docker Desktop running in Linux containers mode)
RUNNER_ENABLED=true
RUNNER_MEMORY_MB=512
RUNNER_MAX_SECONDS=90

# Encrypts stored AI provider keys. Long random text; do not change later. Empty = JWT_SECRET is used.
AI_KEY_SECRET=
AI_TIMEOUT_SECONDS=120
# Terminal in the workspace: none = no network, bridge = internet (npm install / pip install work)
TERMINAL_NETWORK=none
TERMINAL_PORTS=3000,3001,4173,4200,5000,5173,8000,8080
TERMINAL_PORTS_BIND=127.0.0.1

# --- E-mail for "Forgot password" links. Leave empty = the feature answers "not set up". ---
# Address people open WORKCODE at (the reset link starts with it)
APP_URL=http://localhost:5173
# Way 1, Gmail with an app password (Google account -> Security -> 2-Step Verification -> App passwords):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Way 2, Gmail API (OAuth client with scope https://www.googleapis.com/auth/gmail.send). Used instead of SMTP when all three are set.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# --- Workday schedule and screen recording (build 29 + 31). Everything here is already the default, set it only to change it. ---
# Regular working hours before the day is marked complete (developer / onroll / offroll). 0.05 = 3 minutes, handy for a demo.
WORKDAY_TARGET_HOURS=8
# Finished videos (and their pieces) are deleted automatically after this many days. 0 = keep forever.
RECORDING_RETENTION_DAYS=30
# Leaving the workspace tab pauses the recording at once; after this many seconds away it is closed and saved. 0 = close immediately.
RECORDING_AWAY_GRACE_SECONDS=60
